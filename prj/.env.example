# =============================================================================
# GameAnalytics credentials (.env.example)
# =============================================================================
#
# Copy file này thành `.env` và điền credentials thật từ GameAnalytics dashboard.
#
#   cp .env.example .env       # Linux/Mac
#   copy .env.example .env     # Windows
#
# Lấy credentials tại: https://gameanalytics.com → chọn game → Settings → Game Keys
#
# =============================================================================

# -----------------------------------------------------------------------------
# 1. SANDBOX (development/testing)
# -----------------------------------------------------------------------------
# Endpoint: sandbox-api.gameanalytics.com
# Dùng để test/simulation. Dữ liệu bị GA reset định kỳ.
# KHÔNG ảnh hưởng production dashboard.
#
# Lấy từ: GameAnalytics Dashboard → Settings → Game Keys → tab "Sandbox"
GAME_KEY=<your_sandbox_game_key>
SECRET_KEY=<your_sandbox_secret_key>
GA_ENV=sandbox


# -----------------------------------------------------------------------------
# 2. PRODUCTION (live)
# -----------------------------------------------------------------------------
# Endpoint: api.gameanalytics.com
# Dữ liệu thật vào dashboard và report.
# ⚠️  CẨN THẬN: ảnh hưởng metrics thật của game!
#
# Workflow khuyến nghị:
#   1. Test kỹ với sandbox trước (chạy simulation nhiều lần, check dashboard).
#   2. Smoke test pass:  python main.py --players 5 --days 1 --ga-env sandbox
#   3. Sau khi chắc chắn, switch sang production bằng cách thay 3 dòng dưới:
#
# GAME_KEY=<your_production_game_key>
# SECRET_KEY=<your_production_secret_key>
# GA_ENV=production


# -----------------------------------------------------------------------------
# 3. GIỚI HẠN & BEST PRACTICES
# -----------------------------------------------------------------------------
# - Free tier: 100K events/tháng. Trả phí nếu vượt.
# - Mỗi batch tối đa 1MB (post-gzip).
# - Recommended: < 10K events/ngày cho 1 game nhỏ.
# - Sandbox key CHỈ dùng cho sandbox-api. Production key CHỈ dùng cho api.
#   Mix key sai endpoint → 401 Unauthorized.
#
# Test commands:
#   python main.py --players 50 --days 7 --ga-env sandbox    # dev
#   python main.py --players 5  --days 1 --ga-env sandbox    # quick smoke
#   python main.py --dry-run                                 # no GA call
